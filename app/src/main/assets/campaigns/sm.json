  "reputation": [
   {
    "text": {
     "en": "Deal 3 S.H.I.E.L.D. Tech upgrades at random to a player. They keep 1 for the campaign; return the rest. Repeat for each player."
    },
    "when": {
     "all": [
      {
       "counter": "reputation",
       "atLeast": 3
      },
      {
       "notFlag": "node3"
      }
     ]
    },
    "action": {
     "id": "reward3",
     "label": {
      "en": "Done"
     },
     "effects": [
      {
       "op": "setFlag",
       "flag": "node3",
       "boolValue": true
      }
     ]
    },
    "showCardList": "shieldTech"
   },
   {
    "text": {
     "en": "Each player may take 1 additional mulligan during step 13 of setup."
    },
    "when": {
     "counter": "reputation",
     "atLeast": 5
    }
   },
   {
    "text": {
     "en": "Each player adds the maximum copies of one aspect card of their choice to their deck for the rest of the campaign."
    },
    "when": {
     "all": [
      {
       "counter": "reputation",
       "atLeast": 9
      },
      {
       "notFlag": "node9"
      }
     ]
    },
    "action": {
