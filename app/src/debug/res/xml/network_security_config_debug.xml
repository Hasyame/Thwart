<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only, and it exists so sync can actually be tested.

  Android has refused cleartext by default since API 28, which is right and
  which the release build keeps. But it also means a development server on the
  machine running the emulator is unreachable, and the alternative was to test
  the sync client against production or not at all. Neither is acceptable for a
  feature whose failure mode is somebody's campaign log.

  Two addresses, both of which mean "the machine I am developing on" and
  neither of which can reach anything else. 10.0.2.2 is the emulator's alias
  for the host loopback; 127.0.0.1 is what `adb reverse tcp:8787 tcp:8787`
  turns into the same thing, and it is the one that also works from a physical
  phone on a cable. Everything else, debug builds included, still requires TLS.

  This file is in src/debug, so it is not merged into a release build at all.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
